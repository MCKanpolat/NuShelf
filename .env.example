# Copy to .env. Generate independent random values for the two required secrets.
ADMIN_API_KEY=
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:5000
STORAGE_PROVIDER=local
MAX_PACKAGE_BYTES=104857600
DATABASE_CONNECTIONS=20

# S3 / MinIO: set STORAGE_PROVIDER=s3 and run docker compose --profile s3 up --build
AWS_BUCKET=nushelf
AWS_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=nushelf-local
AWS_SECRET_ACCESS_KEY=
AWS_ALLOW_HTTP=true
AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false

# Azure: STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=

# GCS: STORAGE_PROVIDER=gcs; mount the service account file into the app container.
GOOGLE_BUCKET=
GOOGLE_SERVICE_ACCOUNT_PATH=

# Upstream credentials are referenced by name in Manage workspace > Upstream sources.
# Add only the secrets you need; the app Compose service reads this file.
# UPSTREAM_COMPANY_TOKEN=<token>
# UPSTREAM_COMPANY_PASSWORD=<password>
